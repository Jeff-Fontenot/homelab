# Copy to .env and fill in real values. Never commit the real .env file.

# Cloudflare API token(s) for Traefik's DNS-01 ACME challenge.
CF_DNS_API_TOKEN=
# Optional -- see the commented-out line in docker-compose.yml.
CF_ZONE_API_TOKEN=

# Email used for Let's Encrypt registration.
ACME_EMAIL=

# Pi-hole web UI password.
PIHOLE_PASSWORD=
# Password pihole-exporter uses to authenticate to Pi-hole's API.
PIHOLE_EXPORTER_PASSWORD=

# Grafana Cloud remote-write target for Alloy (sanitized portfolio:* metrics only).
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_API_KEY=

# Proxmox API token (dashy@pve!dashy) used by Dashy's Proxmox VM/Container widgets.
DASHY_PROXMOX_TOKEN=
